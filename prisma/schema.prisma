// Skema data SIAP PPA New. ERD dihasilkan dari berkas ini: npm run erd

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============ Enum ============

enum Peran {
  ADMIN
  PENDAMPING

  @@map("peran")
}

/// Status laporan sekaligus status kasus (dilacak satu kolom).
enum StatusLaporan {
  BARU
  DITOLAK
  TERVERIFIKASI
  DALAM_PENDAMPINGAN
  DITUTUP

  @@map("status_laporan")
}

enum StatusSesi {
  TERJADWAL
  BERLANGSUNG
  SELESAI
  TIDAK_HADIR
  DIBATALKAN

  @@map("status_sesi")
}

/// Status antrean; hanya berlaku setelah check-in (Tiket.checkInPada terisi).
enum StatusAntrean {
  MENUNGGU
  DIPANGGIL
  BERLANGSUNG
  SELESAI
  DILEWATI

  @@map("status_antrean")
}

enum StatusUsulan {
  MENUNGGU
  DISETUJUI
  DITOLAK

  @@map("status_usulan")
}

enum PenerimaNotifikasi {
  PELAPOR
  PENDAMPING

  @@map("penerima_notifikasi")
}

// ============ Master ============

model Pengguna {
  id                String   @id @default(cuid())
  nama              String
  email             String   @unique
  kataSandiHash     String   @map("kata_sandi_hash")
  peran             Peran
  aktif             Boolean  @default(true)
  /// Hanya untuk Pendamping: bidang pendampingannya.
  jenisPendampingId String?  @map("jenis_pendamping_id")
  dibuatPada        DateTime @default(now()) @map("dibuat_pada")
  diubahPada        DateTime @updatedAt @map("diubah_pada")

  jenisPendamping      JenisPendampingan?          @relation(fields: [jenisPendampingId], references: [id])
  laporanDiverifikasi  Laporan[]                   @relation("VerifikatorLaporan")
  sesi                 Sesi[]
  laporanPendampingan  LaporanPendampingan[]
  revisi               RevisiLaporanPendampingan[]
  perubahanJadwal      RiwayatJadwal[]
  keputusanUsulan      UsulanSesi[]
  jenisKekerasanDibuat JenisKekerasan[]            @relation("PembuatJenisKekerasan")
  logAudit             LogAudit[]

  @@map("pengguna")
}

model JenisKekerasan {
  id           String    @id @default(cuid())
  nama         String    @unique
  aktif        Boolean   @default(true)
  dibuatPada   DateTime  @default(now()) @map("dibuat_pada")
  /// Diisi otomatis oleh Prisma setiap kali baris diubah; default now() untuk baris yang sudah ada.
  diubahPada   DateTime  @default(now()) @updatedAt @map("diubah_pada")
  /// Admin yang membuat; kosong untuk data lama sebelum kolom ini ada.
  dibuatOlehId String?   @map("dibuat_oleh_id")
  dibuatOleh   Pengguna? @relation("PembuatJenisKekerasan", fields: [dibuatOlehId], references: [id])
  laporan      Laporan[]

  @@map("jenis_kekerasan")
}

/// Bidang pendampingan; `kode` menjadi awalan nomor antrean (PSI, HKM).
model JenisPendampingan {
  id       String     @id @default(cuid())
  kode     String     @unique
  nama     String     @unique
  aktif    Boolean    @default(true)
  pengguna Pengguna[]
  sesi     Sesi[]
  tiket    Tiket[]

  @@map("jenis_pendampingan")
}

model Kecamatan {
  id      String          @id @default(cuid())
  nama    String          @unique
  laporan Laporan[]
  kontak  KontakDarurat[]

  @@map("kecamatan")
}

/// Tempat layanan (mis. UPTD PPA); antrean dihitung per lokasi.
model Lokasi {
  id     String  @id @default(cuid())
  nama   String  @unique
  alamat String
  aktif  Boolean @default(true)
  sesi   Sesi[]
  tiket  Tiket[]

  @@map("lokasi")
}

model KontakDarurat {
  id          String     @id @default(cuid())
  instansi    String
  telepon     String
  alamat      String
  kecamatanId String?    @map("kecamatan_id")
  aktif       Boolean    @default(true)
  kecamatan   Kecamatan? @relation(fields: [kecamatanId], references: [id])

  @@map("kontak_darurat")
}

// ============ Pelaporan ============

model Laporan {
  id                 String        @id @default(cuid())
  kodePendaftaran    String        @unique @map("kode_pendaftaran")
  namaPelapor        String        @map("nama_pelapor")
  kontakPelapor      String        @map("kontak_pelapor")
  namaKorban         String        @map("nama_korban")
  usiaKorban         Int?          @map("usia_korban")
  jenisKelaminKorban String?       @map("jenis_kelamin_korban")
  jenisKekerasanId   String        @map("jenis_kekerasan_id")
  kecamatanId        String?       @map("kecamatan_id")
  tanggalKejadian    DateTime?     @map("tanggal_kejadian")
  kronologi          String
  persetujuanData    Boolean       @map("persetujuan_data")
  persetujuanPada    DateTime      @map("persetujuan_pada")
  status             StatusLaporan @default(BARU)
  alasanPenolakan    String?       @map("alasan_penolakan")
  verifikatorId      String?       @map("verifikator_id")
  diverifikasiPada   DateTime?     @map("diverifikasi_pada")
  ditutupPada        DateTime?     @map("ditutup_pada")
  dibuatPada         DateTime      @default(now()) @map("dibuat_pada")

  jenisKekerasan JenisKekerasan   @relation(fields: [jenisKekerasanId], references: [id])
  kecamatan      Kecamatan?       @relation(fields: [kecamatanId], references: [id])
  verifikator    Pengguna?        @relation("VerifikatorLaporan", fields: [verifikatorId], references: [id])
  dokumen        DokumenLaporan[]
  sesi           Sesi[]

  @@index([status, dibuatPada])
  @@map("laporan")
}

model DokumenLaporan {
  id          String  @id @default(cuid())
  laporanId   String  @map("laporan_id")
  namaBerkas  String  @map("nama_berkas")
  jalurBerkas String  @map("jalur_berkas")
  tipeMime    String  @map("tipe_mime")
  ukuran      Int
  laporan     Laporan @relation(fields: [laporanId], references: [id], onDelete: Cascade)

  @@map("dokumen_laporan")
}

// ============ Pendampingan, tiket, antrean ============

/// Satu laporan dapat memiliki banyak sesi pendampingan.
model Sesi {
  id                String     @id @default(cuid())
  laporanId         String     @map("laporan_id")
  urutan            Int
  jenisPendampingId String     @map("jenis_pendamping_id")
  pendampingId      String     @map("pendamping_id")
  lokasiId          String     @map("lokasi_id")
  mulai             DateTime
  selesai           DateTime
  status            StatusSesi @default(TERJADWAL)
  dibuatPada        DateTime   @default(now()) @map("dibuat_pada")

  laporan             Laporan              @relation(fields: [laporanId], references: [id])
  jenisPendamping     JenisPendampingan    @relation(fields: [jenisPendampingId], references: [id])
  pendamping          Pengguna             @relation(fields: [pendampingId], references: [id])
  lokasi              Lokasi               @relation(fields: [lokasiId], references: [id])
  tiket               Tiket?
  laporanPendampingan LaporanPendampingan?
  riwayat             RiwayatJadwal[]
  notifikasi          Notifikasi[]
  usulanSumber        UsulanSesi?          @relation("SesiHasilUsulan")

  @@unique([laporanId, urutan])
  @@index([pendampingId, mulai])
  @@map("sesi")
}

/// Tiket per sesi. Nomor antrean: {kode}-{YYYYMMDD}-{urutan}, urut per lokasi per jenis per hari.
model Tiket {
  id                String        @id @default(cuid())
  sesiId            String        @unique @map("sesi_id")
  nomorAntrean      String        @unique @map("nomor_antrean")
  tanggal           DateTime      @db.Date
  urutan            Int
  lokasiId          String        @map("lokasi_id")
  jenisPendampingId String        @map("jenis_pendamping_id")
  /// Isi QR; dipindai petugas untuk check-in.
  kodeCheckIn       String        @unique @map("kode_check_in")
  statusAntrean     StatusAntrean @default(MENUNGGU) @map("status_antrean")
  checkInPada       DateTime?     @map("check_in_pada")
  dipanggilPada     DateTime?     @map("dipanggil_pada")
  selesaiPada       DateTime?     @map("selesai_pada")
  diterbitkanPada   DateTime      @default(now()) @map("diterbitkan_pada")

  sesi            Sesi              @relation(fields: [sesiId], references: [id])
  lokasi          Lokasi            @relation(fields: [lokasiId], references: [id])
  jenisPendamping JenisPendampingan @relation(fields: [jenisPendampingId], references: [id])

  @@unique([lokasiId, jenisPendampingId, tanggal, urutan])
  @@index([lokasiId, tanggal, statusAntrean])
  @@map("tiket")
}

model RiwayatJadwal {
  id         String   @id @default(cuid())
  sesiId     String   @map("sesi_id")
  pengubahId String   @map("pengubah_id")
  /// Nilai sebelum dan sesudah, mis. {"mulai": {"dari": "...", "ke": "..."}}.
  perubahan  Json
  alasan     String?
  dibuatPada DateTime @default(now()) @map("dibuat_pada")
  sesi       Sesi     @relation(fields: [sesiId], references: [id])
  pengubah   Pengguna @relation(fields: [pengubahId], references: [id])

  @@map("riwayat_jadwal")
}

model Notifikasi {
  id          String             @id @default(cuid())
  sesiId      String             @map("sesi_id")
  penerima    PenerimaNotifikasi
  kanal       String
  pesan       String
  dikirimPada DateTime?          @map("dikirim_pada")
  dibuatPada  DateTime           @default(now()) @map("dibuat_pada")
  sesi        Sesi               @relation(fields: [sesiId], references: [id])

  @@map("notifikasi")
}

// ============ Laporan pendampingan ============

/// Terkunci setelah `dikirimPada` terisi; koreksi lewat RevisiLaporanPendampingan.
model LaporanPendampingan {
  id                 String    @id @default(cuid())
  sesiId             String    @unique @map("sesi_id")
  penulisId          String    @map("penulis_id")
  jenisPendampingan  String    @map("jenis_pendampingan")
  keterangan         String
  rekomendasi        String
  ajukanSesiLanjutan Boolean   @default(false) @map("ajukan_sesi_lanjutan")
  versi              Int       @default(1)
  dikirimPada        DateTime? @map("dikirim_pada")
  dibuatPada         DateTime  @default(now()) @map("dibuat_pada")
  diubahPada         DateTime  @updatedAt @map("diubah_pada")

  sesi    Sesi                        @relation(fields: [sesiId], references: [id])
  penulis Pengguna                    @relation(fields: [penulisId], references: [id])
  foto    FotoPendampingan[]
  revisi  RevisiLaporanPendampingan[]
  usulan  UsulanSesi?

  @@map("laporan_pendampingan")
}

model FotoPendampingan {
  id                    String              @id @default(cuid())
  laporanPendampinganId String              @map("laporan_pendampingan_id")
  namaBerkas            String              @map("nama_berkas")
  jalurBerkas           String              @map("jalur_berkas")
  tipeMime              String              @map("tipe_mime")
  ukuran                Int
  laporanPendampingan   LaporanPendampingan @relation(fields: [laporanPendampinganId], references: [id], onDelete: Cascade)

  @@map("foto_pendampingan")
}

model RevisiLaporanPendampingan {
  id                    String              @id @default(cuid())
  laporanPendampinganId String              @map("laporan_pendampingan_id")
  versi                 Int
  /// Salinan isi laporan sebelum direvisi.
  isiSebelumnya         Json                @map("isi_sebelumnya")
  alasan                String
  pengubahId            String              @map("pengubah_id")
  dibuatPada            DateTime            @default(now()) @map("dibuat_pada")
  laporanPendampingan   LaporanPendampingan @relation(fields: [laporanPendampinganId], references: [id])
  pengubah              Pengguna            @relation(fields: [pengubahId], references: [id])

  @@unique([laporanPendampinganId, versi])
  @@map("revisi_laporan_pendampingan")
}

/// Usulan sesi lanjutan dari rekomendasi Pendamping; Admin menyetujui dan menjadwalkan.
model UsulanSesi {
  id                    String              @id @default(cuid())
  laporanPendampinganId String              @unique @map("laporan_pendampingan_id")
  status                StatusUsulan        @default(MENUNGGU)
  keputusanOlehId       String?             @map("keputusan_oleh_id")
  diputuskanPada        DateTime?           @map("diputuskan_pada")
  sesiHasilId           String?             @unique @map("sesi_hasil_id")
  dibuatPada            DateTime            @default(now()) @map("dibuat_pada")
  laporanPendampingan   LaporanPendampingan @relation(fields: [laporanPendampinganId], references: [id])
  keputusanOleh         Pengguna?           @relation(fields: [keputusanOlehId], references: [id])
  sesiHasil             Sesi?               @relation("SesiHasilUsulan", fields: [sesiHasilId], references: [id])

  @@map("usulan_sesi")
}

// ============ Audit ============

model LogAudit {
  id         String    @id @default(cuid())
  penggunaId String?   @map("pengguna_id")
  aksi       String
  entitas    String
  entitasId  String    @map("entitas_id")
  rincian    Json?
  dibuatPada DateTime  @default(now()) @map("dibuat_pada")
  pengguna   Pengguna? @relation(fields: [penggunaId], references: [id])

  @@index([entitas, entitasId])
  @@map("log_audit")
}
